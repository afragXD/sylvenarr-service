generator client {
  provider = "prisma-client"
  output   = "../src/shared/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum MatchStatus {
  waiting
  ready
  cancelled
}

enum RatingResult {
  win
  loss
}

/// Класс героя из каталога (статы из legacy stats_dict).
model HeroClass {
  code         String   @id
  displayName  String
  /// Lore со слайдов arenamsterbot/imgs/intro.
  description  String   @default("")
  /// Геймплейная роль со слайдов intro.
  roleSummary  String   @default("")
  health       Int
  damage       Int
  armor        Int
  initiative   Int
  dodge        Int
  luck         Int
  morale       Int
  mana         Int
  power        Int
  gold         Int
  accuracy     Int
  isPlayable   Boolean  @default(true)
  sortOrder    Int      @default(0)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  ratingEntries RatingEntry[]
}

/// Гостевой игрок (сессия по cookie).
model Player {
  id          String   @id @default(cuid())
  displayName String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  hostedMatches  Match[]       @relation("MatchHost")
  guestMatches   Match[]       @relation("MatchGuest")
  ratingEntries  RatingEntry[]
}

/// Лобби / матч до старта боя.
model Match {
  id         String      @id @default(cuid())
  status     MatchStatus @default(waiting)
  inviteCode String      @unique
  hostId     String
  guestId    String?
  createdAt  DateTime    @default(now())
  updatedAt  DateTime    @updatedAt

  host  Player  @relation("MatchHost", fields: [hostId], references: [id])
  guest Player? @relation("MatchGuest", fields: [guestId], references: [id])

  @@index([status])
  @@index([hostId])
}

/// Запись результата матча для рейтинга.
model RatingEntry {
  id            String       @id @default(cuid())
  playerId      String
  result        RatingResult
  heroClassCode String?
  createdAt     DateTime     @default(now())

  player    Player     @relation(fields: [playerId], references: [id])
  heroClass HeroClass? @relation(fields: [heroClassCode], references: [code])

  @@index([playerId])
}
