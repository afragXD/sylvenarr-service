generator client {
  provider = "prisma-client"
  output   = "../src/shared/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum MatchStatus {
  waiting
  ready
  drafting
  drafted
  fighting
  finished
  cancelled
}

enum RatingResult {
  win
  loss
}

/// Класс героя из каталога (статы из legacy stats_dict).
model HeroClass {
  code         String   @id
  displayName  String
  /// Lore со слайдов arenamsterbot/imgs/intro.
  description  String   @default("")
  /// Геймплейная роль со слайдов intro.
  roleSummary  String   @default("")
  health       Int
  damage       Int
  armor        Int
  initiative   Int
  dodge        Int
  luck         Int
  morale       Int
  mana         Int
  power        Int
  gold         Int
  accuracy     Int
  /// Слоты квоты отряда (гиганты = 2).
  size         Int      @default(1)
  isPlayable   Boolean  @default(true)
  sortOrder    Int      @default(0)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  ratingEntries RatingEntry[]
  matchPicks    MatchPick[]
}

/// Игрок (создаётся только через OAuth).
model Player {
  id          String   @id @default(cuid())
  displayName String
  email       String?
  avatarUrl   String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  hostedMatches  Match[]        @relation("MatchHost")
  guestMatches   Match[]        @relation("MatchGuest")
  ratingEntries  RatingEntry[]
  oauthAccounts  OAuthAccount[]
  matchPicks     MatchPick[]
}

/// Привязка внешнего OAuth-провайдера к игроку.
model OAuthAccount {
  id             String   @id @default(cuid())
  playerId       String
  provider       String
  providerUserId String
  email          String?
  rawProfile     Json?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  player Player @relation(fields: [playerId], references: [id], onDelete: Cascade)

  @@unique([provider, providerUserId])
  @@index([playerId])
}

/// Лобби / матч / бой.
model Match {
  id                 String      @id @default(cuid())
  status             MatchStatus @default(waiting)
  inviteCode         String      @unique
  hostId             String
  guestId            String?
  winnerPlayerId     String?
  /// Момент перехода в fighting (для длительности боя).
  fightingStartedAt  DateTime?
  finishedAt         DateTime?
  /// Финальный снимок боя для истории (составы, статы, лог).
  resultSnapshot     Json?
  /// Снимок правил матча при create (квоты, раунды, HP%, резерв ярмарки).
  rules              Json?
  createdAt          DateTime    @default(now())
  updatedAt          DateTime    @updatedAt

  host  Player  @relation("MatchHost", fields: [hostId], references: [id])
  guest Player? @relation("MatchGuest", fields: [guestId], references: [id])
  picks MatchPick[]

  @@index([status])
  @@index([hostId])
  @@index([guestId])
}

/// Пик героя в draft.
model MatchPick {
  id            String   @id @default(cuid())
  matchId       String
  playerId      String
  heroClassCode String
  /// 0 = передний ряд, 1 = задний.
  row           Int
  pickOrder     Int
  createdAt     DateTime @default(now())

  match     Match     @relation(fields: [matchId], references: [id], onDelete: Cascade)
  player    Player    @relation(fields: [playerId], references: [id])
  heroClass HeroClass @relation(fields: [heroClassCode], references: [code])

  @@index([matchId])
  @@index([playerId])
}

/// Запись результата матча для рейтинга.
model RatingEntry {
  id            String       @id @default(cuid())
  playerId      String
  result        RatingResult
  heroClassCode String?
  createdAt     DateTime     @default(now())

  player    Player     @relation(fields: [playerId], references: [id])
  heroClass HeroClass? @relation(fields: [heroClassCode], references: [code])

  @@index([playerId])
}
