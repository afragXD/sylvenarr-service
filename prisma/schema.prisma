generator client {
  provider = "prisma-client"
  output   = "../src/shared/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum MatchStatus {
  waiting
  ready
  drafting
  drafted
  fighting
  finished
  cancelled
}

enum RatingResult {
  win
  loss
  draw
}

enum PlayerRole {
  player
  admin
}

enum NewsCategory {
  announcement
  devlog
  update
  fix
}

/// Источник пика в draft.
enum MatchPickSource {
  draft
  preset
}

/// Класс героя из каталога (статы из legacy stats_dict).
model HeroClass {
  code         String   @id
  displayName  String
  /// Lore со слайдов arenamsterbot/imgs/intro.
  description  String   @default("")
  /// Геймплейная роль со слайдов intro.
  roleSummary  String   @default("")
  health       Int
  damage       Int
  armor        Int
  initiative   Int
  dodge        Int
  luck         Int
  morale       Int
  mana         Int
  /// Константный потолок маны класса (обычно = стартовой mana).
  maxMana      Int      @default(0)
  power        Int
  gold         Int
  accuracy     Int
  /// Слоты квоты отряда (гиганты = 2).
  size         Int      @default(1)
  isPlayable   Boolean  @default(true)
  sortOrder    Int      @default(0)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  ratingEntries   RatingEntry[]
  matchPicks      MatchPick[]
  pickStats       HeroPickStat[]
  presetSlots     SquadPresetSlot[]
  roleTags        HeroClassRoleTag[]
}

/// Ролевой тег класса (ДД-МАГ, ПРИЗЫВАТЕЛЬ, …).
model HeroRoleTag {
  id        String   @id
  /// Подпись для UI (КАПСОМ).
  label     String
  /// Mood для цвета чипа: offense | support | heal | control | summon | curse | identity.
  mood      String
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  heroes HeroClassRoleTag[]
}

/// Связь героя с ролевым тегом (порядок чипов у класса).
model HeroClassRoleTag {
  heroClassCode String
  tagId         String
  sortOrder     Int      @default(0)

  heroClass HeroClass   @relation(fields: [heroClassCode], references: [code], onDelete: Cascade)
  tag       HeroRoleTag @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([heroClassCode, tagId])
  @@index([tagId])
}

/// Игрок (OAuth и/или пароль).
model Player {
  id           String     @id @default(uuid()) @db.Uuid
  displayName  String     @unique
  email        String?    @unique
  /// Argon2id hash; не отдаём в API.
  passwordHash String?
  avatarUrl    String?
  /// ПТС (сезонный рейтинг Heroes III / StickyFingaz). Нулевой уровень = 1500.
  pts          Int        @default(1500)
  role         PlayerRole @default(player)
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  hostedMatches  Match[]        @relation("MatchHost")
  guestMatches   Match[]        @relation("MatchGuest")
  ratingEntries  RatingEntry[]
  oauthAccounts  OAuthAccount[]
  matchPicks     MatchPick[]
  pickStats      HeroPickStat[]
  news           News[]
  squadPresets   SquadPreset[]
}

/// Новость хроники разработки.
model News {
  id          String       @id @default(uuid()) @db.Uuid
  slug        String       @unique
  title       String
  summary     String
  body        String
  category    NewsCategory @default(devlog)
  coverUrl    String?
  publishedAt DateTime?
  authorId    String?      @db.Uuid
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  author Player? @relation(fields: [authorId], references: [id], onDelete: SetNull)

  @@index([publishedAt])
}

/// Привязка внешнего OAuth-провайдера к игроку.
model OAuthAccount {
  id             String   @id @default(uuid()) @db.Uuid
  playerId       String   @db.Uuid
  provider       String
  providerUserId String
  email          String?
  rawProfile     Json?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  player Player @relation(fields: [playerId], references: [id], onDelete: Cascade)

  @@unique([provider, providerUserId])
  @@index([playerId])
}

/// Лобби / матч / бой.
model Match {
  id                 String      @id @default(uuid()) @db.Uuid
  status             MatchStatus @default(waiting)
  inviteCode         String      @unique
  hostId             String      @db.Uuid
  guestId            String?     @db.Uuid
  winnerPlayerId     String?     @db.Uuid
  /// Момент перехода в fighting (для длительности боя).
  fightingStartedAt  DateTime?
  finishedAt         DateTime?
  /// Финальный снимок боя для истории (составы, статы, лог).
  resultSnapshot     Json?
  /// Снимок правил матча при create (квоты, раунды, HP%, резерв ярмарки).
  rules              Json?
  createdAt          DateTime    @default(now())
  updatedAt          DateTime    @updatedAt

  host  Player  @relation("MatchHost", fields: [hostId], references: [id])
  guest Player? @relation("MatchGuest", fields: [guestId], references: [id])
  picks MatchPick[]

  @@index([status])
  @@index([hostId])
  @@index([guestId])
}

/// Пик героя в draft.
model MatchPick {
  id            String          @id @default(uuid()) @db.Uuid
  matchId       String          @db.Uuid
  playerId      String          @db.Uuid
  heroClassCode String
  /// 0 = передний ряд, 1 = задний.
  row           Int
  pickOrder     Int
  source        MatchPickSource @default(draft)
  createdAt     DateTime        @default(now())

  match     Match     @relation(fields: [matchId], references: [id], onDelete: Cascade)
  player    Player    @relation(fields: [playerId], references: [id])
  heroClass HeroClass @relation(fields: [heroClassCode], references: [code])

  @@index([matchId])
  @@index([playerId])
}

/// Пресет отряда: личный (playerId) или глобальный (playerId = null, только admin).
model SquadPreset {
  id          String   @id @default(uuid()) @db.Uuid
  name        String
  /// Сумма size слотов (3–6).
  teamSize    Int
  /// null = глобальный пресет.
  playerId    String?  @db.Uuid
  /// Стабильный код seed-глобальных; у личных null.
  catalogCode String?  @unique
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  player Player?           @relation(fields: [playerId], references: [id], onDelete: Cascade)
  slots  SquadPresetSlot[]

  @@index([playerId, teamSize])
}

model SquadPresetSlot {
  id            String @id @default(uuid()) @db.Uuid
  presetId      String @db.Uuid
  heroClassCode String
  /// 0 = передний ряд, 1 = задний.
  row           Int
  slotOrder     Int

  preset    SquadPreset @relation(fields: [presetId], references: [id], onDelete: Cascade)
  heroClass HeroClass   @relation(fields: [heroClassCode], references: [code])

  @@index([presetId])
  @@unique([presetId, slotOrder])
}

/// Счётчик выборов героя игроком (инкремент при финализации боя).
model HeroPickStat {
  playerId      String   @db.Uuid
  heroClassCode String
  pickCount     Int      @default(0)
  updatedAt     DateTime @updatedAt

  player    Player    @relation(fields: [playerId], references: [id], onDelete: Cascade)
  heroClass HeroClass @relation(fields: [heroClassCode], references: [code])

  @@id([playerId, heroClassCode])
  @@index([heroClassCode])
  @@index([pickCount])
}

/// Запись результата матча для рейтинга.
model RatingEntry {
  id            String       @id @default(uuid()) @db.Uuid
  playerId      String       @db.Uuid
  result        RatingResult
  heroClassCode String?
  matchId       String?      @db.Uuid
  ptsBefore     Int?
  ptsDelta      Int?
  ptsAfter      Int?
  createdAt     DateTime     @default(now())

  player    Player     @relation(fields: [playerId], references: [id])
  heroClass HeroClass? @relation(fields: [heroClassCode], references: [code])

  @@index([playerId])
  @@index([matchId])
}
