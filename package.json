{
  "name": "sylvenarr-service",
  "type": "module",
  "scripts": {
    "dev": "bun --watch src/index.ts",
    "start": "NODE_ENV=production bun run ./src/index.ts",
    "lint": "bun x @biomejs/biome check src",
    "format": "bun lint --write",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev",
    "prisma:seed": "bun prisma/seed.ts",
    "test": "bun test src"
  },
  "prisma": {
    "seed": "bun prisma/seed.ts"
  },
  "dependencies": {
    "@elysiajs/cors": "1.4.0",
    "@elysiajs/static": "1.4.6",
    "@elysiajs/swagger": "1.3.1",
    "@prisma/adapter-pg": "7.2.0",
    "@prisma/client": "7.2.0",
    "elysia": "^1.4.16",
    "env-var": "7.5.0"
  },
  "devDependencies": {
    "@biomejs/biome": "2.4.6",
    "@types/bun": "1.3.2",
    "@types/pg": "^8.16.0",
    "dotenv": "^16.4.7",
    "husky": "^9.1.7",
    "prisma": "7.2.0",
    "typescript": "5.9.3"
  }
}
