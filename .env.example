NODE_ENV=development
PORT=4000

# DATABASE_URL=postgresql://postgres:postgres@localhost:5432/sylvenarr_service
DATABASE_URL=

# Redis — не нужен для MVP-1; понадобится с realtime-боем (фаза 3)
# REDIS_URL=redis://default:password@localhost:6379

# Публичный URL API (опционально; иначе собирается из PUBLIC_DOMAIN)
# API_URL=http://localhost:4000
# PUBLIC_DOMAIN=localhost:4000

# Ключ для мутирующих операций (POST/PUT/DELETE)
API_KEY=

FRONTEND_URL=http://localhost:3000
LOCAL_FRONTEND_URL=http://localhost:3000
LOCAL_FRONTEND_URL2=https://localhost:3000

# Yandex OAuth (oauth.yandex.ru). Провайдер включается, если заданы все три.
# Callback URL в кабинете: {API_URL}/auth/yandex/callback
YANDEX_CLIENT_ID=
YANDEX_CLIENT_SECRET=
YANDEX_REDIRECT_URI=http://localhost:4000/auth/yandex/callback

# Куда вернуть пользователя после OAuth (опционально)
# AUTH_SUCCESS_REDIRECT=http://localhost:3000/lobby
# AUTH_ERROR_REDIRECT=http://localhost:3000/sign-in
